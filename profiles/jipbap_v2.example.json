      "weight": 700,
      "preferred_family": "Gaegu",
      "fallback_families": [
        "Jua",
        "Do Hyeon",
        "sans-serif"
      ],
      "authority": "fallback_only_when_presentation_master_unspecified"
    },
    "cover_episode_label": {
      "family_intent": "friendly_round_display",
      "nominal_size": 30,
      "min_size": 26,
      "max_size": 36,
      "weight": 700,
      "preferred_family": "Gaegu",
      "fallback_families": [
        "Nanum Pen Script",
        "Jua",
        "Noto Sans KR",
        "sans-serif"
      ],
      "authority": "fallback_only_when_presentation_master_unspecified"
    }
  },
  "font_resolution": {
    "silent_substitution_allowed": false,
    "surface_missing_preferred_font_warning": true,
    "preview_export_must_share_resolved_family": true,
    "font_binary_is_authority": false
  },
  "presentation_design": {
    "mode": "PRESENTATION_MASTER_FIRST",
    "approved_master_is_upstream_visual_target": true,
    "editor_scene_is_downstream_reconstruction": true,
    "editor_defaults_are_fallback_only": true,
    "silent_design_simplification_for_tool_compatibility": false,
    "literal_copy_authority": "PLAN_APPROVED_COPY",
    "accepted_artwork_identity_preserved_in_final_reconstruction": true,
    "target_provenance_required": true,
    "parity_qc_required_after_reconstruction": true,
    "routine_second_user_gate_after_parity": false
  }
}
