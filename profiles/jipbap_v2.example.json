{
  "schema": "JIPBAP_PRESENTATION_SHELL_V2",
  "template_id": "JIPBAP_PRESENTATION_SHELL_V2",
  "profile_id": "JIPBAP_DEFAULT_V2",
  "canvas": {
    "width": 1080,
    "height": 1350,
    "ratio": "4:5"
  },
  "profile_semantics": {
    "kind": "project_default_not_editor_capability_boundary",
    "automatic_production": true,
    "allow_custom_override": true,
    "override_class": "CUSTOM_OVERRIDE",
    "override_is_scene_corruption": false,
    "revision": "2026-09-09_MANUAL_OVERRIDE_PROVENANCE_V1"
  },
  "page_structure": {
    "automatic_default": {
      "cover": 1,
      "body": 6
    },
    "editor_capabilities": {
      "add": true,
      "delete": true,
      "duplicate": true,
      "page_type_change": true
    },
    "deviations_require_explicit_user_editor_action": true
  },
  "body": {
    "artwork_frame": {
      "x": 0,
      "y": 0,
      "width": 1080,
      "height": 1350,
      "fit": "frame_crop",
      "default_locked": true,
      "allow_stretch": false
    },
    "semantic_placement": {
      "speech": "freeform_overlay",
      "sfx": "freeform_overlay",
      "inner_thought": "freeform_overlay",
      "narration": "freeform_overlay"
    },
    "page_markers": false,
    "group_contract": {
      "top_level_pattern": [
        "{page}.background",
        "{page}.artwork",
        "{page}.lettering",
        "{page}.overlay"
      ],
      "lettering_instance_patterns": [
        "{page}.speech.NN",
        "{page}.thought.NN",
        "{page}.narration.NN",
        "{page}.sfx.NN"
      ],
      "fixed_instance_count": false
    },
    "layout_mode": "FULL_ART_OVERLAY",
    "safe_inset": {
      "left": 48,
      "top": 48,
      "right": 48,
      "bottom": 48,
      "kind": "soft_hint"
    },
    "placement_policy": {
      "strategy": "presentation_master_inherit_then_focal_aware_fallback",
      "optional_metadata": [
        "placement_guides",
        "avoid_regions"
      ],
      "avoid_roles": [
        "face_primary",
        "food_primary",
        "hand_action"
      ],
      "structural_band_required": false,
      "lettering_move_is_custom_override": false
    },
    "artwork_source_policy": {
      "mode": "accepted_board_cell",
      "record_provenance": true,
      "extraction_metadata_reuse": true,
      "replacement_requires_explicit_override": true
    }
  },
  "cover": {
    "title_region": {
      "x": 48,
      "y": 36,
      "width": 984,
      "height": 330,
      "kind": "soft_hint"
    },
    "hero_frame": {
      "x": 0,
      "y": 0,
      "width": 1080,
      "height": 1350,
      "fit": "frame_crop",
      "default_locked": true,
      "allow_stretch": false
    },
    "default_objects": [
      "full_canvas_artwork",
      "episode_label",
      "title"
    ],
    "subtitle_default": false,
    "group_contract": {
      "top_level": [
        "cover.background",
        "cover.artwork",
        "cover.lettering",
        "cover.overlay"
      ],
      "lettering_children": [
        "cover.episode_label",
        "cover.title"
      ],
      "subtitle_group": "optional_hidden_by_default",
      "optional_lettering_children": [
        "cover.menu_tag"
      ]
    },
    "layout_mode": "FULL_ART_OVERLAY",
    "artwork_source_policy": {
      "mode": "distinct_cover_hero_default",
      "record_provenance": true,
      "automatic_body_reuse": false,
      "body_reuse_requires_explicit_selection": true,
      "replacement_requires_explicit_override": true,
      "focal_aware_lettering": true
    },
    "placement_policy": {
      "strategy": "presentation_master_inherit_then_focal_aware_fallback",
      "optional_metadata": [
        "placement_guides",
        "avoid_regions"
      ],
      "avoid_roles": [
        "face_primary",
        "food_primary",
        "hand_action"
      ],
      "reflow_before_obstruction": true
    },
    "title_system": {
      "id": "COVER_TITLE_SYSTEM_V1",
      "semantic_fields": [
        "episode_no",
        "topic_phrase",
        "food_name"
      ],
      "composed_pattern": "EP.{episode_no} {topic_phrase}와 {food_name}",
      "rendering": {
        "episode_label": {
          "literal_pattern": "EP.{episode_no}",
          "typography_role": "cover_episode_label",
          "visual_role": "compact_series_label",
          "container_default": "none",
          "enclosure_default": false
        },
        "main_title": {
          "literal_pattern": "{topic_phrase}와 {food_name}",
          "typography_role": "cover_title",
          "max_lines": 3,
          "food_name_emphasis": "allowed_restrained"
        }
      },
      "topic_phrase_policy": {
        "kind": "short_natural_noun_phrase",
        "avoid_full_plot_summary": true,
        "compress_before_layout_overflow": true
      },
      "menu_tag_policy": {
        "editor_capability": true,
        "automatic_default": false,
        "avoid_redundant_food_name": true
      },
      "layout_policy": {
        "exact_coordinates_frozen": false,
        "use_soft_title_region": true,
        "focal_aware": true,
        "reflow_before_focal_obstruction": true,
        "allow_left_right_adaptation": true
      }
    }
  },
  "editor_defaults": {
    "background": {
      "locked": true,
      "visible": true
    },
    "artwork": {
      "locked": true,
      "visible": true,
      "crop_editable": true,
      "explicit_unlock_allows_frame_transform": true
    },
    "lettering": {
      "locked": false,
      "visible": true
    },
    "overlay": {
      "locked": false,
      "visible": true,
      "default_empty": true
    },
    "frame_transform_after_explicit_unlock": {
      "move": true,
      "resize": true,
      "rotation": true
    },
    "image_replacement_capability": true,
    "guides": {
      "soft_guides_visible_default": false,
      "toggleable": true,
      "snap_to_placement_guides": true,
      "snap_to_avoid_region_edges": true,
      "export_visible": false
    },
    "manual_edit_policy": {
      "preservation": "property_level",
      "automatic_layout_preserves_manual": true,
      "explicit_reset_scope_required": true,
      "line_break_override_separate_from_literal_text": true,
      "overflow_after_copy_change": "surface_attention_do_not_silent_shrink"
    }
  },
  "z_bands": {
    "background": [
      0,
      0
    ],
    "artwork": [
      1,
      9
    ],
    "lettering": [
      10,
      99
    ],
    "overlay": [
      100,
      199
    ]
  },
  "lettering": {
    "speech": {
      "container": "organic_bubble",
      "fill": "#FFFFFF",
      "stroke": "#2A2A2A",
      "stroke_width": 3,
      "tail": {
        "enabled": true,
        "style": "soft_curved",
        "default_attach_side": "bottom",
        "default_attach": 0.55,
        "default_base_width": 42,
        "default_curve": 0.72,
        "editable_handles": [
          "tip",
          "attach"
        ],
        "editable_numeric": [
          "base_width",
          "curve"
        ],
        "max_auto_length": 180,
        "auto_avoid_roles": [
          "face_primary",
          "food_primary",
          "hand_action"
        ],
        "manual_length_unrestricted": true
      },
      "body_style": "soft_oval",
      "radius_ratio": 0.48,
      "horizontal_flip_editable": true
    },
    "inner_thought": {
      "container": "thought_box_optional",
      "fill": "#FFF7E8",
      "stroke": "#B7A995",
      "stroke_width": 2,
      "tail": false
    },
    "narration": {
      "container": "optional",
      "tail": false,
      "editable": true
    },
    "sfx": {
      "container": "none",
      "editable": true,
      "rotation_allowed": true
    },
    "presentation_master_policy": {
      "bubble_shape": "inherit_when_specified",
      "tail_geometry": "inherit_when_specified",
      "line_breaks": "inherit_when_specified",
      "typography_character": "inherit_when_specified",
      "position_scale_rotation": "inherit_when_specified",
      "shell_values_are": "fallback_only"
    }
  },
  "typography_roles": {
    "cover_menu_tag": {
      "family_intent": "friendly_round_display",
      "nominal_size": 30,
      "min_size": 26,
      "max_size": 34,
      "weight": 700,
      "preferred_family": "Jua",
      "fallback_families": [
        "Do Hyeon",
        "Noto Sans KR",
        "sans-serif"
      ],
      "authority": "fallback_only_when_presentation_master_unspecified"
    },
    "cover_title": {
      "family_intent": "friendly_handdrawn_display",
      "nominal_size": 92,
      "min_size": 72,
      "max_size": 112,
      "weight": 700,
      "preferred_family": "Gaegu",
      "fallback_families": [
        "Nanum Pen Script",
        "Jua",
        "Do Hyeon",
        "Noto Sans KR",
        "sans-serif"
      ],
      "authority": "fallback_only_when_presentation_master_unspecified"
    },
    "body_speech": {
      "family_intent": "friendly_round_body",
      "nominal_size": 42,
      "min_size": 36,
      "max_size": 46,
      "weight": 700,
      "preferred_family": "Gaegu",
      "fallback_families": [
        "Nanum Pen Script",
        "Jua",
        "Gowun Dodum",
        "Noto Sans KR",
        "sans-serif"
      ],
      "authority": "fallback_only_when_presentation_master_unspecified"
    },
    "body_thought": {
      "family_intent": "friendly_round_body",
      "nominal_size": 38,
      "min_size": 34,
      "max_size": 42,
      "weight": 400,
      "preferred_family": "Gowun Dodum",
      "fallback_families": [
        "Jua",
